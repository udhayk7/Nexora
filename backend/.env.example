# Nexora Backend Environment Variables
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Nexora API"
API_V1_STR="/api/v1"

# Security & Tokens
SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=5
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
DATABASE_URL=postgresql+psycopg://nexora_user:change_me_in_local_env@localhost:5432/nexora_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text


# ==========================================
# AI PROVIDER CONFIGURATION
# ==========================================

# Primary Provider - OpenAI
AI_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_ADVANCED_MODEL=gpt-4o

# Secondary Provider - Google Gemini
AI_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# AI Fallback
AI_ENABLE_FALLBACK=true
AI_FALLBACK_ON_ERROR=true

# AI Usage Limits
AI_DAILY_BUDGET_USD=2.00
AI_MONTHLY_BUDGET_USD=30.00

AI_ENABLE_CACHING=true