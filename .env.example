# Nexora Monorepo Environment Variables Template
# Copy this file to .env for local docker-compose or global setups.
# NEVER commit the actual .env file or real secrets to version control.

# Environment
NODE_ENV=development
ENVIRONMENT=development
DEBUG=True

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database Configuration (PostgreSQL)
POSTGRES_USER=nexora_user
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=nexora_db
POSTGRES_HOST=postgres
DATABASE_URL=postgresql+psycopg://nexora_user:change_me_in_local_env@localhost:5432/nexora_db
DB_SSL_MODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=False

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Application Security & Tokens
SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=5
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth & Gmail Integration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GMAIL_TOKEN_ENCRYPTION_KEY=change_me_to_a_secure_32_byte_base64_or_hex_key_in_production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Storage & Uploads
STORAGE_LOCAL_PATH=storage/resumes
MAX_UPLOAD_SIZE_BYTES=10485760

# AI Intelligence & Dual-Provider Routing
# AI_PROVIDER options: openai | gemini | mock | none
AI_PROVIDER=openai
AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=gemini
AI_FALLBACK_TO_DETERMINISTIC=True

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STRONG_MODEL=gemini-1.5-pro

# AI Cost Management & Limits
AI_DAILY_BUDGET_USD=10.00
AI_MONTHLY_BUDGET_USD=100.00
AI_USER_DAILY_TOKEN_LIMIT=150000
AI_USER_DAILY_BUDGET_USD=2.00
AI_ENABLE_RESPONSE_CACHE=True
AI_RESPONSE_CACHE_TTL_SECONDS=86400

# AI Request Tuning
AI_MAX_INPUT_CHARS=25000
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000

